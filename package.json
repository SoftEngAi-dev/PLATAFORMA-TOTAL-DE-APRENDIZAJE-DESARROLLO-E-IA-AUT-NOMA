{
  "name": "plataforma-total-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first AI development studio: chat + agent orchestration + visual canvas + project workspace + sandboxed execution.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:all": "npm run test && npm run typecheck",
    "dev": "concurrently -k \"npm run agent\" \"npm --workspace @plataforma/desktop run dev\"",
    "agent": "npm --workspace @plataforma/ai-orchestrator run dev"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "concurrently": "^9.1.2"
  }
}
