{
  "name": "@plataforma/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma Total de Aprendizaje - aplicación de escritorio para PC",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview --host 127.0.0.1",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.0.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "typescript": "^5.6.3",
    "vite": "^5.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.plataforma.desktop",
    "productName": "Plataforma Total de Aprendizaje",
    "directories": { "buildResources": "assets" },
    "files": ["dist/**/*", "dist-electron/**/*"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.education" },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage", "deb"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
