{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@plataforma/*": [
        "packages/*/src"
      ]
    }
  },
  "include": [
    "apps",
    "services",
    "packages"
  ]
}
