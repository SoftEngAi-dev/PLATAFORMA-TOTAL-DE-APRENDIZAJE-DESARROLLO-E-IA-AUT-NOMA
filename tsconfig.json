{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@plataforma/shared/*": ["packages/shared/*"] }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "services/**/*.ts", "packages/**/*.ts"]
}
